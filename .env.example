# Copy to .env. npm run setup:demo creates a local-only configuration automatically.
DATABASE_URL=postgresql://grove:local-development-only@localhost:5432/familygrove
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
MEDIA_ENCRYPTION_KEY=replace-with-64-hex-characters
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.private-media
MAX_AUDIO_BYTES=3145728
MAX_AUDIO_SECONDS=90
# SMTP is required for live passwordless email login.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Production private storage (S3 compatible); public access must be blocked.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# HTTPS private malware-scanner gateway. Required for production audio uploads.
AUDIO_SCAN_URL=
AUDIO_SCAN_TOKEN=
# Rate limits are transactionally stored in PostgreSQL; no Redis account needed.
